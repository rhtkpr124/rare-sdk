{
  "name": "@rareprotocol/rare-sdk",
  "version": "0.2.0",
  "description": "SuperRare / Rare Protocol TypeScript SDK: marketplace, minting, auctions, offers, releases, and the Rare API client",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superrare/rare-sdk.git"
  },
  "homepage": "https://github.com/superrare/rare-sdk#readme",
  "bugs": {
    "url": "https://github.com/superrare/rare-sdk/issues"
  },
  "keywords": [
    "ethereum",
    "nft",
    "rare-protocol",
    "sdk",
    "superrare",
    "web3"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/sdk/index.d.ts",
        "default": "./dist/sdk/index.js"
      },
      "require": {
        "types": "./dist/sdk/index.d.cts",
        "default": "./dist/sdk/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/sdk/index.d.ts",
        "default": "./dist/sdk/index.js"
      },
      "require": {
        "types": "./dist/sdk/index.d.cts",
        "default": "./dist/sdk/index.cjs"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/sdk/contracts.d.ts",
        "default": "./dist/sdk/contracts.js"
      },
      "require": {
        "types": "./dist/sdk/contracts.d.cts",
        "default": "./dist/sdk/contracts.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/sdk/public-utils.d.ts",
        "default": "./dist/sdk/public-utils.js"
      },
      "require": {
        "types": "./dist/sdk/public-utils.d.cts",
        "default": "./dist/sdk/public-utils.cjs"
      }
    },
    "./data-access": {
      "import": {
        "types": "./dist/data-access/index.d.ts",
        "default": "./dist/data-access/index.js"
      },
      "require": {
        "types": "./dist/data-access/index.d.cts",
        "default": "./dist/data-access/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "typecheck": "tsc --noEmit",
    "generate:types": "tsx scripts/generate-openapi-types.ts",
    "generate:cart-types": "tsx scripts/generate-cart-types.ts",
    "docs:build": "typedoc",
    "package:check": "tsx scripts/validate-package.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test",
    "test:integration:uploads": "vitest run test/integration-deployed/uploads.test.ts",
    "test:integration:account": "vitest run test/integration-deployed/account-auth.test.ts test/integration-deployed/account-origins.test.ts test/integration-deployed/account-transport.test.ts --no-file-parallelism",
    "test:integration": "RARE_API_INTEGRATION=1 vitest run test/integration/liquid-edition-discovery.test.ts",
    "prepare": "npm run build",
    "test:integration:follows": "vitest run test/integration-deployed/follows.test.ts",
    "test:integration:favorites": "vitest run test/integration-deployed/favorites.test.ts",
    "test:integration:posts": "vitest run test/integration-deployed/posts.test.ts",
    "test:integration:drops": "vitest run test/integration-deployed/drops.test.ts",
    "test:integration:messaging": "vitest run test/integration-deployed/messaging.test.ts test/integration-deployed/messaging-browser.test.ts test/integration-deployed/messaging-authorization.test.ts test/integration-deployed/messaging-public.test.ts test/integration-deployed/messaging-public-delivery.test.ts --no-file-parallelism",
    "test:integration:messaging:public": "vitest run test/integration-deployed/messaging-public.test.ts test/integration-deployed/messaging-public-delivery.test.ts --no-file-parallelism",
    "test:integration:nfts": "vitest run test/integration-deployed/nft-search.test.ts",
    "test:integration:notifications": "vitest run test/integration-deployed/notifications.test.ts",
    "test:integration:account:browser:sessions": "vitest run test/integration-deployed/browser-session-store.test.ts --no-file-parallelism",
    "test:integration:account:browser": "vitest run test/integration-deployed/account-browser.test.ts --no-file-parallelism",
    "lint": "eslint src test scripts eslint-local-rules",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run test:typecheck && vitest run --exclude 'test/e2e-live/**' --exclude 'test/integration-deployed/**' --config vitest.config.ts",
    "test:live": "npm run build && npm run test:typecheck && vitest run --config vitest.config.ts",
    "test:coverage": "npm run build && npm run test:typecheck && vitest run --exclude 'test/e2e-live/**' --exclude 'test/integration-deployed/**' --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "merkletreejs": "0.6.0",
    "openapi-fetch": "0.17.0",
    "viem": "2.54.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "@typescript-eslint/parser": "8.59.2",
    "@typescript-eslint/rule-tester": "8.59.2",
    "@typescript-eslint/utils": "8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "10.3.0",
    "eslint-plugin-functional": "^9.0.4",
    "globals": "17.6.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  },
  "main": "./dist/sdk/index.cjs",
  "module": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "client": [
        "./dist/sdk/index.d.ts"
      ],
      "contracts": [
        "./dist/sdk/contracts.d.ts"
      ],
      "utils": [
        "./dist/sdk/public-utils.d.ts"
      ],
      "data-access": [
        "./dist/data-access/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
